  "setup": {
    "providers": [
      {
        "id": "google-antigravity-cli",
        "envVars": [
          "ANTIGRAVITY_USER_DATA_DIR"
        ]
      }
    ],
    "cliBackends": [
      "google-antigravity-cli"
    ]
  },
  "providerAuthChoices": [
    {
      "provider": "google-antigravity-cli",
      "method": "custom",
      "choiceId": "google-antigravity-cli",
      "choiceLabel": "Google Antigravity CLI",
      "choiceHint": "Delegate agent turns to a local signed-in agy CLI",
      "groupId": "google-antigravity-cli",
      "groupLabel": "Google Antigravity CLI",
      "groupHint": "Local CLI runtime",
      "onboardingScopes": [
        "text-inference"
      ]
    }
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "command": {
        "type": "string",
        "default": "agy"
      },
      "printTimeout": {
        "type": "string",
        "default": "30m0s",
        "description": "Timeout for agy --print invocations (e.g. 15m0s, 30m0s)"
      },
      "stream": {
        "type": "boolean",
        "default": false,
        "description": "Stream thoughts and text deltas in real-time via stream-json"
      },
      "userDataDir": {
        "type": "string",
        "description": "Custom Antigravity data directory (default: ~/.gemini/antigravity-cli)"
      }
    }
  }
